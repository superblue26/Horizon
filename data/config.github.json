{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "architecture": {
        "threshold": 4.5,
        "topic_dedup": true
      },
      "visa-policy": {
        "threshold": 4.5,
        "topic_dedup": true
      },
      "tech-news": {
        "threshold": 5.5,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 5.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.0,
        "topic_dedup": false
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "MIT Technology Review",
        "url": "https://www.technologyreview.com/feed/",
        "enabled": true,
        "category": "tech",
        "profile": "tech-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "OpenAI Blog",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "tech",
        "profile": "tech-news"
      },
      {
        "name": "The Verge",
        "url": "https://www.theverge.com/rss/index.xml",
        "enabled": true,
        "category": "tech",
        "profile": "tech-news"
      },
      {
        "name": "美联储货币政策发布",
        "url": "https://www.federalreserve.gov/feeds/press_monetary.xml",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "麦肯锡深度洞察 (McKinsey)",
        "url": "https://www.mckinsey.com/Insights/rss.aspx",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Yahoo Finance",
        "url": "https://finance.yahoo.com/news/rssindex",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "路透社财经 (官网锁定)",
        "url": "https://news.google.com/rss/search?q=site:reuters.com/business&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "Archinect (海外建筑职场与行业)",
        "url": "https://archinect.com/feed/home",
        "enabled": true,
        "category": "architecture",
        "profile": "architecture",
        "content_extractor": "trafilatura"
      },
      {
        "name": "ArchDaily",
        "url": "https://www.archdaily.com/feed",
        "enabled": true,
        "category": "architecture",
        "profile": "architecture"
      },
      {
        "name": "Dezeen Architecture",
        "url": "https://www.dezeen.com/architecture/feed/",
        "enabled": true,
        "category": "architecture",
        "profile": "architecture"
      },
      {
        "name": "美加澳新建筑远程与BIM机会",
        "url": "https://news.google.com/rss/search?q=architecture+remote+jobs+OR+BIM+freelance+US+Canada+Australia+New+Zealand&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "architecture",
        "profile": "architecture"
      },
      {
        "name": "CIC News (加拿大工签与移民)",
        "url": "https://www.cicnews.com/feed",
        "enabled": true,
        "category": "visa-policy",
        "profile": "visa-policy",
        "content_extractor": "trafilatura"
      },
      {
        "name": "美国移民局 USCIS 官网动态",
        "url": "https://news.google.com/rss/search?q=site:uscis.gov/newsroom+H1B+OR+visa+OR+work&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "visa-policy",
        "profile": "visa-policy"
      },
      {
        "name": "澳新移民局官网动态",
        "url": "https://news.google.com/rss/search?q=(site:immi.homeaffairs.gov.au+OR+site:immigration.govt.nz)+visa+OR+skilled+OR+architect&hl=en-AU&gl=AU&ceid=AU:en",
        "enabled": true,
        "category": "visa-policy",
        "profile": "visa-policy"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 0
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "architecture",
      "visa-policy",
      "tech-news",
      "finance-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
